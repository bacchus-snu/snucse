@import "mixin.styl"
@import "variable.styl"
#login-background
  min-height 100vh
  background header-color
#login-box-container
  position absolute
  width 500px
  height 340px
  top 0
  bottom 0
  left 0
  right 0
  margin auto
#login-github
  float right
  margin-top 12px
  font-size 16px
.login-github-link
  color background-color
#login-box-title
  font-size 28px
  line-height 30px
  font-weight 400
  color background-color
  margin-bottom 10px
#login-box
  background-color background-color
  width 500px
  height 300px
  padding 15px
#login-box-header
  text-align center
  font-size 18px
  padding-bottom 15px
  border-bottom 1px solid box-border-color
#login-button-container
  padding 20px 0
  text-align center
#login-button
  cursor pointer
  background header-color-2
  border 1px solid header-color-1
  color background-color
  padding 0 20px
  height 40px
  border-radius 4px
  font-size 14px
#login-box-footer
  border-top 1px solid box-border-color
  padding-top 15px
  text-align center
  font-size 14px
.login-box-footer-link
  color text-color
  margin 0 20px
@media (max-width: 768px)
  #login-background
    position static
  #login-box-container
    width 100%
    height 350px
    padding 10px
  #login-box
    width 100%
    height 270px
